{

  "manifest_version": 3,
  "name": "Mangafreak Prettfier",
  "version": "1.0",
  "description": "Removes ads and prettifies Mangafreak",
  "content_scripts": [
    {
      "matches": ["*://*.mangafreak.me/*"],
      "js": ["prettify_mangafreak.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://tcbonepiecechapters.com/*"],
      "js": ["prettify_tcb.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "Addons@MangaFreakPrettifier",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": []
}
